# --- App ---
APP_NAME=outfit_assistant
DATABASE_URL=sqlite:///./data/sqlite/sessions.db
USER_ID=default_user

# --- Azure OpenAI: chat model (gpt-4o), used by LiteLLM / ADK agents ---
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2024-08-01-preview

# --- Azure OpenAI: embeddings (text-embedding-ada-002), used by Weaviate text2vec-openai ---
AZURE_API_KEY_EMB=
AZURE_API_BASE_EMB=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION_EMB=2024-08-01-preview

# --- Weaviate (overridden by docker-compose when running in containers) ---
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
